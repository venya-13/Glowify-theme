{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'vendor-swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{{ 'component-featured-carousel.css' | asset_url | stylesheet_tag }}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} isolate gradient">
  <div class="collection section-{{ section.id }}-padding" id="featured-carousel-{{ section.id }}">
    <div class="collection__title title-wrapper title-wrapper--no-top-margin page-width">
      {%- if section.settings.title != blank -%}
        <h2 class="title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}
    </div>

    <featured-carousel-section
      class="featured-carousel page-width"
      data-slides-desktop="{{ section.settings.slides_per_view_desktop }}"
      data-center-mode="{{ section.settings.center_mode }}"
      data-autoplay="{{ section.settings.autoplay }}"
      data-autoplay-speed="{{ section.settings.autoplay_speed }}"
      data-pagination="{{ section.settings.show_pagination }}"
      data-fade="{{ section.settings.enable_fade }}"
    >
      <div class="swiper featured-carousel__swiper">
        <div class="swiper-wrapper">
          {%- if section.settings.collection.products.size > 0 -%}
            {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
              <div class="swiper-slide">
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: 'portrait',
                  lazy_load: forloop.index > 2,
                  show_secondary_image: true,
                  quick_add: section.settings.quick_add
                %}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..6) -%}
              <div class="swiper-slide">
                {% render 'card-product', media_aspect_ratio: 'portrait', lazy_load: false, placeholder_image: 'product-apparel-1' %}
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
      <div class="featured-carousel__nav">
        <button type="button" class="featured-carousel__button featured-carousel__button--prev" aria-label="{{ 'general.slider.previous_slide' | t }}">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </button>
        <div class="featured-carousel__pagination"></div>
        <button type="button" class="featured-carousel__button featured-carousel__button--next" aria-label="{{ 'general.slider.next_slide' | t }}">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </button>
      </div>
    </featured-carousel-section>
  </div>
</div>

<script src="{{ 'vendor-swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'featured-carousel.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Featured carousel (Swiper)",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 25,
      "step": 1,
      "default": 8,
      "label": "Maximum products to show"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Shop Our Glow",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "range",
      "id": "slides_per_view_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Slides per view (desktop)"
    },
    {
      "type": "checkbox",
      "id": "center_mode",
      "default": true,
      "label": "Center active slide (peek + scale)"
    },
    {
      "type": "checkbox",
      "id": "enable_fade",
      "default": false,
      "label": "Fade transition instead of slide"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "default": true,
      "label": "Autoplay"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4,
      "label": "Autoplay delay"
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "default": true,
      "label": "Show pagination dots"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "select",
      "id": "quick_add",
      "default": "standard",
      "label": "Quick add button",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "standard", "label": "Standard" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Featured carousel (Swiper)"
    }
  ]
}
{% endschema %}
